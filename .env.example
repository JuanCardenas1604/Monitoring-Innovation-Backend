# Monitoring Innovation API — copiar a .env en local

# Obligatorio en producción (Railway genera uno automático si no se asigna)
SECRET_KEY=genera-un-secreto-largo-y-aleatorio-aqui

# Local: SQLite | Railway: Railway inyecta ${{Postgres.DATABASE_URL}} automáticamente
DATABASE_URL=sqlite:///./monitoring_innovation.db

ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=False
PASSWORD_HISTORY_LIMIT=5

# CORS — una URL o varias separadas por coma (* solo en desarrollo)
CORS_ORIGINS=https://monitoringin.netlify.app/

# URL del frontend (enlaces de recuperación de contraseña)
FRONTEND_URL=https://monitoringin.netlify.app/

# SMTP — Gmail con contraseña de aplicación (opcional en local / Railway)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Monitoring Innovation
