# Monitoring Innovation API — copiar a .env en local

# Obligatorio en producción (Railway)
SECRET_KEY=genera-un-secreto-largo-y-aleatorio-aqui

# Local: SQLite | Railway: referencia ${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite:///./monitoring_innovation.db

ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=True

# CORS — una URL o varias separadas por coma (* solo en desarrollo)
CORS_ORIGINS=http://localhost:5173

# URL del frontend (enlaces de recuperación de contraseña)
FRONTEND_URL=http://localhost:5173

# SMTP — Gmail con contraseña de aplicación (opcional en local)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Monitoring
