# Monitoring Innovation API — Variables de entorno

# Secreto para firmar los JWT (cambiar en producción)
SECRET_KEY=monitoring-innovation-secret-key-change-in-production

# Base de datos (SQLite por defecto, cambiar a PostgreSQL en producción)
DATABASE_URL=sqlite:///./monitoring_innovation.db

# Tiempo de expiración del token JWT en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Modo debug
DEBUG=True

# SMTP — Gmail (crear app en https://myaccount.google.com/apppasswords, ej. "Monitoring")
# SMTP_PASSWORD = 16 caracteres sin espacios (no uses la contraseña normal de Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
